      "choices": {
        "solved": "Answered question",
        "tip": "Tip",
        "open": "Open question",
        "other": "Other"
      }
    }
  },
  "presets": [
    {"id": "orda", "label": "ORDA", "params": "area=database&q=orda"},
    {"id": "forms", "label": "Forms & list boxes", "params": "area=interface&q=form listbox"},
